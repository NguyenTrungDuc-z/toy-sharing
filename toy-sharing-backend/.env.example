PORT=5000
MONGO_URI=mongodb://localhost:27017/toy_sharing
JWT_SECRET=your_jwt_secret_here

# Google OAuth (Đăng nhập Google) - lấy từ Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Tài khoản ADMIN nhận tiền cọc (escrow) - dùng để sinh mã VietQR
# ADMIN_BANK_ID: mã ngân hàng VietQR (vd: 970436 = Vietcombank)
ADMIN_BANK_ID=970436
ADMIN_BANK_ACCOUNT=0123456789
ADMIN_BANK_NAME=TOYSHARE ESCROW
