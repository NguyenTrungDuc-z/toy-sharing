PORT=5000
MONGO_URI=mongodb://localhost:27017/toy_sharing
JWT_SECRET=your_jwt_secret_here

# Google OAuth (Đăng nhập Google) - lấy từ Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Tài khoản ADMIN nhận tiền cọc (escrow) - dùng để sinh mã VietQR
# ADMIN_BANK_ID: mã ngân hàng VietQR (vd: 970436 = Vietcombank)
ADMIN_BANK_ID=970436
ADMIN_BANK_ACCOUNT=0123456789
ADMIN_BANK_NAME=TOYSHARE ESCROW

# Cấu hình gửi Email qua Gmail (Nodemailer SMTP)
# EMAIL_USER: tài khoản gmail của bạn (vd: yourname@gmail.com)
# EMAIL_PASS: Mật khẩu ứng dụng 16 ký tự (Google Account -> Bảo mật -> Xác minh 2 bước -> Mật khẩu ứng dụng)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
FRONTEND_URL=http://localhost:5173
# URL frontend để chèn vào email (nhắc hạn, đồ yêu thích sẵn sàng)
CLIENT_URL=http://localhost:5173

# Tài khoản admin khởi tạo lần đầu (KHÔNG hardcode mật khẩu trong code)
ADMIN_EMAIL=admin@toyshare.com
ADMIN_PASSWORD=đổi_mật_khẩu_mạnh_ở_đây

# Nhắc trả đồ trước hạn bao nhiêu giờ (mặc định 24)
DUE_SOON_HOURS=24
